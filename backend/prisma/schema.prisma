generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  active    Boolean   @default(true)
  deletedAt DateTime?
  role      Role      @default(ADMIN)
}

model Property {
  id              String    @id @default(uuid())
  title           String
  description     String
  location        String
  price           Float
  bedrooms        Int?
  bathrooms       Int?
  area            Float?
  imageUrl        String?
  status          String    @default("AVAILABLE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  featured        Boolean   @default(false)
  gallery         String[]
  longDescription String?
  metaDescription String?
  metaTitle       String?
  published       Boolean   @default(true)
  slug            String?   @unique
}

model Project {
  id              String        @id @default(uuid())
  title           String
  description     String
  imageUrl        String?
  category        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  featured        Boolean       @default(false)
  gallery         String[]
  longDescription String?
  metaDescription String?
  metaTitle       String?
  published       Boolean       @default(false)
  slug            String?       @unique
  status          ContentStatus @default(DRAFT)
}

model Blog {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  content         String
  imageUrl        String?
  published       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  category        String?
  deletedAt       DateTime?
  excerpt         String?
  featured        Boolean       @default(false)
  metaDescription String?
  metaTitle       String?
  publishedAt     DateTime?
  scheduledAt     DateTime?
  status          ContentStatus @default(DRAFT)
  tags            String[]
}

model Contact {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  createdAt   DateTime      @default(now())
  archivedAt  DateTime?
  readAt      DateTime?
  replyStatus ReplyStatus   @default(PENDING)
  status      ContactStatus @default(UNREAD)
}

model Service {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  description     String
  longDescription String?
  category        String?
  tabId           String?   @unique
  tabLabel        String?
  eyebrow         String?
  heroTitle       String?
  heroHighlight   String?
  featuredLabel   String?
  featuredTitle   String?
  featuredCtaLabel String?
  featuredCtaHref String?
  processTitle    String?
  faqTitle        String?
  ctaTitle        String?
  ctaSubtitle     String?
  ctaLabel        String?
  ctaHref         String?
  pricingNote     String?
  priceTableHeaders String[]
  showTestimonials Boolean  @default(false)
  showEngagements  Boolean  @default(false)
  icon            String?
  imageUrl        String?
  gallery         String[]
  displayOrder    Int       @default(0)
  published       Boolean   @default(false)
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cards           ServiceCard[]
  features        ServiceFeature[]
  processSteps    ServiceProcessStep[]
  faqs            ServiceFaq[]
  pricingPlans    ServicePricingPlan[]
  pricingRows     ServicePricingRow[]
  testimonials    ServiceTestimonial[]
  engagements     ServiceEngagement[]
}

model ServiceCard {
  id           String   @id @default(uuid())
  serviceId    String
  icon         String?
  title        String
  description  String
  tags         String[]
  displayOrder Int      @default(0)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceFeature {
  id           String   @id @default(uuid())
  serviceId    String
  text         String
  displayOrder Int      @default(0)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceProcessStep {
  id           String   @id @default(uuid())
  serviceId    String
  number       String
  firstLine    String
  secondLine   String
  displayOrder Int      @default(0)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceFaq {
  id           String   @id @default(uuid())
  serviceId    String
  question     String
  answer       String
  displayOrder Int      @default(0)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServicePricingPlan {
  id           String   @id @default(uuid())
  serviceId    String
  name         String
  price        String
  note         String?
  features     String[]
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServicePricingRow {
  id           String   @id @default(uuid())
  serviceId    String
  item         String
  price        String
  duration     String
  highlighted  Boolean  @default(false)
  displayOrder Int      @default(0)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceTestimonial {
  id           String   @id @default(uuid())
  serviceId    String
  quote        String
  name         String
  role         String
  displayOrder Int      @default(0)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceEngagement {
  id           String   @id @default(uuid())
  serviceId    String
  icon         String?
  title        String
  description  String
  displayOrder Int      @default(0)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Realisation {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  category        String?
  categoryLabel   String?
  year            Int?
  client          String?
  location        String?
  completionDate  DateTime?
  imageUrl        String?
  gallery         String[]
  description     String
  surface         String?
  surfaceValue    Float?
  levels          String?
  budget          String?
  result          String?
  color           String?
  servicesUsed    String[]
  technicalTags   String[]
  features        String[]
  published       Boolean   @default(false)
  featured        Boolean   @default(false)
  displayOrder    Int       @default(0)
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  metrics         RealisationMetric[]
}

model RealisationMetric {
  id            String      @id @default(uuid())
  realisationId String
  label         String
  value         String
  displayOrder  Int         @default(0)
  realisation   Realisation @relation(fields: [realisationId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id        String   @id @default(uuid())
  url       String
  publicId  String   @unique
  folder    String?
  fileName  String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String?
  entityId  String?
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ReplyStatus {
  PENDING
  REPLIED
}
