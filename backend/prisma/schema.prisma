generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  active    Boolean   @default(true)
  deletedAt DateTime?
  role      Role      @default(ADMIN)
}

model Property {
  id              String    @id @default(uuid())
  title           String
  description     String
  location        String
  price           Float
  bedrooms        Int?
  bathrooms       Int?
  area            Float?
  imageUrl        String?
  status          String    @default("AVAILABLE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  featured        Boolean   @default(false)
  gallery         String[]
  longDescription String?
  metaDescription String?
  metaTitle       String?
  published       Boolean   @default(true)
  slug            String?   @unique
}

model Project {
  id              String        @id @default(uuid())
  title           String
  description     String
  imageUrl        String?
  category        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  featured        Boolean       @default(false)
  gallery         String[]
  longDescription String?
  metaDescription String?
  metaTitle       String?
  published       Boolean       @default(false)
  slug            String?       @unique
  status          ContentStatus @default(DRAFT)
}

model Blog {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  content         String
  imageUrl        String?
  published       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  category        String?
  deletedAt       DateTime?
  excerpt         String?
  featured        Boolean       @default(false)
  metaDescription String?
  metaTitle       String?
  publishedAt     DateTime?
  scheduledAt     DateTime?
  status          ContentStatus @default(DRAFT)
  tags            String[]
}

model Contact {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  createdAt   DateTime      @default(now())
  archivedAt  DateTime?
  readAt      DateTime?
  replyStatus ReplyStatus   @default(PENDING)
  status      ContactStatus @default(UNREAD)
}

model Service {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  description     String
  longDescription String?
  category        String?
  icon            String?
  imageUrl        String?
  gallery         String[]
  displayOrder    Int       @default(0)
  published       Boolean   @default(false)
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Realisation {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  client          String?
  location        String?
  completionDate  DateTime?
  imageUrl        String?
  gallery         String[]
  description     String
  servicesUsed    String[]
  published       Boolean   @default(false)
  featured        Boolean   @default(false)
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MediaAsset {
  id        String   @id @default(uuid())
  url       String
  publicId  String   @unique
  folder    String?
  fileName  String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String?
  entityId  String?
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ReplyStatus {
  PENDING
  REPLIED
}
